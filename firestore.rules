// ============================================================================
// SAGE-TI — Regras de segurança do Firestore
// ----------------------------------------------------------------------------
// Em produção (js/store.js, js/firebase.js): equipamentos, movimentacoes,
// usuarios e auditoria vivem no Firestore do projeto `sagi-ti`. Publicar
// mudanças aqui com `firebase deploy --only firestore:rules`.
//
// Perfis (espelham SAGETI.PERFIS em js/config.js):
//   admin   — CRUD completo (é o único que pode excluir)
//   tecnico — pode criar e ler; NUNCA pode excluir (nem alterar o próprio perfil)
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Perfil do usuário autenticado -----------------------------------
    // Lido do próprio documento em /usuarios/{uid}, não de custom claims —
    // assim o perfil pode ser gerenciado por um admin direto no Firestore,
    // do mesmo jeito que o gerenciador de listas do app já funciona.
    function perfilDoUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function autenticado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return autenticado() && perfilDoUsuario() == 'admin';
    }

    // tecnico e admin podem criar/editar; leitura pura (perfil "leitura") não.
    function podeEscrever() {
      return autenticado() && perfilDoUsuario() in ['admin', 'tecnico'];
    }

    // Tombo é opcional (preenchido depois) — mas quando presente precisa ser
    // string curta, nunca outro tipo nem um payload gigante.
    function tomboValido(v) {
      return v == null || (v is string && v.size() <= 40);
    }

    // ---- usuarios: cada um lê o próprio perfil; só admin gerencia contas --
    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || ehAdmin());
      allow create, update, delete: if ehAdmin();
    }

    // ---- equipamentos: inventário do estoque -------------------------------
    // Campos usados pelos índices (status, dataEntrada, dataSaida, noLaboratorio)
    // são os mesmos já gravados por SAGETI.store.registrarEntrada/registrarSaida.
    match /equipamentos/{id} {
      allow read: if autenticado();
      allow create: if podeEscrever()
        && tomboValido(request.resource.data.tomboNovo)
        && tomboValido(request.resource.data.tomboAntigo);
      allow update: if podeEscrever()
        && tomboValido(request.resource.data.tomboNovo)
        && tomboValido(request.resource.data.tomboAntigo);
      allow delete: if ehAdmin(); // técnico é bloqueado — regra central do requisito de RBAC
    }

    // ---- movimentacoes: histórico de entrada/saída (nunca é editado/apagado) --
    match /movimentacoes/{id} {
      allow read: if autenticado();
      allow create: if podeEscrever();
      allow update, delete: if ehAdmin(); // histórico só é corrigido por admin, em último caso
    }

    // ---- auditoria: trilha de "quem mudou o quê" — append-only de verdade --
    // Ninguém apaga nem edita um log, nem admin: é o que torna a auditoria
    // confiável. `descricao` já vem pronta (texto simples) de js/store.js —
    // aqui só garantimos forma e tamanho, nunca confiamos no campo bruto.
    match /auditoria/{id} {
      allow read: if autenticado();
      allow create: if podeEscrever()
        && request.resource.data.keys().hasOnly(['acao', 'entidade', 'entidadeId', 'descricao', 'usuario', 'registradoEm'])
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 60
        && request.resource.data.entidade is string && request.resource.data.entidade.size() <= 40
        && request.resource.data.descricao is string && request.resource.data.descricao.size() <= 500
        && request.resource.data.usuario is string && request.resource.data.usuario.size() <= 80;
      allow update, delete: if false;
    }

    // ---- listas: status, TTR, setores, técnicos, modelos etc. (gerenciador) --
    match /listas/{chave} {
      allow read: if autenticado();
      allow write: if podeEscrever(); // tecnico também gerencia listas (SAGETI.PERFIS.tecnico.podeGerenciarListas)
    }

    // Qualquer coleção fora do esquema acima fica fechada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
