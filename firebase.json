{
  "hosting": [
    {
      "site": "sage-ti",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "tests/**",
        "functions/**",
        "js/config.properties*.js",
        "package.json",
        "package-lock.json",
        "servidor.py",
        "doc.txt",
        "assets/LEIA-ME.txt",
        "README.md"
      ]
    },
    {
      "site": "sagi-ti",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "tests/**",
        "functions/**",
        "js/config.properties*.js",
        "package.json",
        "package-lock.json",
        "servidor.py",
        "doc.txt",
        "assets/LEIA-ME.txt",
        "README.md"
      ],
      "redirects": [
        { "source": "**", "destination": "https://sage-ti.web.app", "type": 301 }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8090 },
    "functions": { "port": 5001 },
    "hosting": { "port": 5050 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
